# Déploiement — ePavillon v2. Copier en `.env.prod` sur le serveur applicatif.
#
#   cp .env.prod.example .env.prod   puis renseigner ce qui est marqué À REMPLIR
#   docker compose --env-file .env.prod -f ops/docker-compose.prod.yml up -d --build
#
# NON VERSIONNÉ : ce fichier-ci l'est, `.env.prod` ne doit jamais l'être.
#
# ┌─ AUCUN COMMENTAIRE EN FIN DE LIGNE ─────────────────────────────────────┐
# │ `CLE=valeur   # explication` fait valoir à CLE toute la fin de la ligne, │
# │ commentaire compris, selon le lecteur qui l'analyse. Le cas qui coûte le │
# │ plus cher est `AUTH_COOKIE_DOMAIN`, qui doit rester VIDE : renseigné par │
# │ un commentaire, il pose un cookie sur un domaine absurde et l'authenti-  │
# │ fication échoue sans une ligne d'erreur nulle part. Les explications     │
# │ vont donc AU-DESSUS de la clé, jamais après.                            │
# └─────────────────────────────────────────────────────────────────────────┘
#
# La configuration est validée AU DÉMARRAGE : une clé manquante, une durée mal
# écrite ou une adresse d'expéditeur mal formée arrêtent le service en disant
# laquelle. Aucune de ces erreurs ne se découvre à l'usage.

# --- Ce que voient les visiteurs --------------------------------------------
# L'adresse complète, PRÉFIXE COMPRIS. Trois choses en dérivent, et elles se
# déduisent en sens contraire :
#   · l'origine autorisée en écriture — sans le préfixe, un navigateur n'en
#     annonce jamais dans son en-tête `Origin`
#   · le chemin des cookies — AVEC le préfixe, sinon la session meurt au bout de
#     quinze minutes sans message ni trace
#   · la base des liens envoyés par courriel — avec le préfixe, sinon un lien de
#     vérification d'adresse mène à la v1
# Le jour de la bascule à la racine, retirer `/v2` ici et dans les deux valeurs
# du bloc « Site » suffit — plus une reconstruction de l'image du site.
APP_PUBLIC_URL=https://epavillonclimatique.francophonie.org/v2

# --- Ports locaux ------------------------------------------------------------
# Publiés sur `127.0.0.1` UNIQUEMENT : c'est l'Apache du VPS qui les atteint,
# et rien de cette pile n'est joignable depuis l'extérieur.
# 3000 est déjà pris par l'application de `financedurable` — d'où 3100.
FRONT_PORT=3100
API_PORT=8080

# --- Site --------------------------------------------------------------------
# FIGÉES À LA CONSTRUCTION de l'image : la base préfixe chaque URL d'asset
# écrite dans le HTML. Les changer sans reconstruire ne les réécrit pas.
NUXT_APP_BASE_URL=/v2/
NUXT_PUBLIC_API_BASE=/v2/api

# L'adresse INTERNE de l'API, lue par le rendu serveur seul. Elle est posée par
# le fichier de compose et n'a pas à être reprise ici ; elle y figure pour que
# le rôle des deux bases se lise au même endroit. Un chemin n'a pas d'origine :
# au rendu serveur, `/v2/api` désignerait Nitro lui-même, et les pages
# publiques se rendraient vides — pour les moteurs de recherche d'abord.
# NUXT_API_BASE_SERVER=http://api:8080/api

# --- Base de données ---------------------------------------------------------
# À REMPLIR : `openssl rand -base64 32 | tr -d '/+='`
POSTGRES_PASSWORD=

# --- Authentification --------------------------------------------------------
# À REMPLIR : `openssl rand -hex 32`, puis NE PLUS EN CHANGER — la remplacer
# invalide toutes les sessions en cours.
AUTH_SIGNING_KEY=
AUTH_COOKIE_SECURE=true
# LAISSER VIDE. Le cookie se rattache alors au seul hôte que le navigateur a
# contacté, ce qui est exactement le comportement voulu derrière deux relais.
AUTH_COOKIE_DOMAIN=

# --- Mandataires de confiance ------------------------------------------------
# Deux sauts, donc deux entrées : le réseau interne de Docker, d'où l'Apache du
# VPS atteint l'API, et l'adresse du cPanel institutionnel, qui a constaté celle
# du visiteur. L'API remonte la chaîne de droite à gauche en sautant les
# mandataires connus ; le premier inconnu est le client.
#
# Les OUBLIER n'empêche rien de fonctionner : ça fait simplement enregistrer
# l'adresse du relais dans chaque session et chaque ligne d'audit, à la place de
# celle du visiteur. Le défaut ferme — il vaut mieux une adresse fausse mais
# visible qu'une adresse que le client aurait choisie lui-même.
TRUSTED_PROXIES=172.28.0.0/16,68.168.118.201

# --- Courriel ----------------------------------------------------------------
# L'API envoie elle-même, par le serveur du domaine, en client authentifié.
MAIL_TRANSPORT=smtp
SMTP_HOST=epavillonclimatique.francophonie.org
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
# À REMPLIR : la boîte créée dans le cPanel institutionnel.
SMTP_USERNAME=
# À REMPLIR.
SMTP_PASSWORD=
# À REMPLIR, avec la MÊME valeur que SMTP_USERNAME : un serveur de soumission
# n'accepte le plus souvent qu'un expéditeur appartenant au compte authentifié.
# Une autre adresse se fait refuser en 550, au premier message.
SMTP_FROM=
SMTP_FROM_NAME=ePavillon

# --- Stockage objet ----------------------------------------------------------
S3_REGION=garage
S3_BUCKET=epavillon
S3_ENDPOINT=http://garage:3900
S3_FORCE_PATH_STYLE=true
MEDIA_STORAGE=s3
# À REMPLIR : les deux clés rendues par `make garage-init` sur ce serveur.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Traces ------------------------------------------------------------------
# LAISSER VIDE : aucun collecteur n'est déployé. La renseigner ferait tenter un
# export à chaque trace, vers un service absent.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=epavillon-api
RUST_LOG=info
