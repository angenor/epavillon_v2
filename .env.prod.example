# Déploiement — ePavillon v2. Copier en `.env.prod` sur le serveur applicatif.
#
#   cp .env.prod.example .env.prod   puis renseigner ce qui est marqué À REMPLIR
#   docker compose --env-file .env.prod -f ops/docker-compose.prod.yml up -d --build
#
# NON VERSIONNÉ : ce fichier-ci l'est, `.env.prod` ne doit jamais l'être.
#
# La configuration est validée AU DÉMARRAGE : une clé manquante, une durée mal
# écrite ou une adresse d'expéditeur mal formée arrêtent le service en disant
# laquelle. Aucune de ces erreurs ne se découvre à l'usage.

# --- Ce que voient les visiteurs --------------------------------------------
# L'adresse complète, PRÉFIXE COMPRIS. Trois choses en dérivent, et elles se
# déduisent en sens contraire :
#   · l'origine autorisée en écriture — sans le préfixe, un navigateur n'en
#     annonce jamais dans son en-tête `Origin`
#   · le chemin des cookies — AVEC le préfixe, sinon la session meurt au bout de
#     quinze minutes sans message ni trace
#   · la base des liens envoyés par courriel — avec le préfixe, sinon un lien de
#     vérification d'adresse mène à la v1
# Le jour de la bascule à la racine, retirer `/v2` ici et dans les trois valeurs
# du bloc suivant suffit.
APP_PUBLIC_URL=https://epavillonclimatique.francophonie.org/v2

# --- Ce que voient les deux serveurs entre eux -------------------------------
# Adresse de transport, jamais montrée. Elle existe pour CHIFFRER le segment
# entre le cPanel et ce serveur : sans elle, les cookies de session
# traverseraient l'Internet public en clair.
PUBLIC_HOSTNAME=epavillon.mefali.com
PUBLIC_BASE_URL=https://epavillonclimatique.francophonie.org/v2
ADMIN_EMAIL=            # À REMPLIR — reçoit les avis d'expiration de certificat

# --- Site --------------------------------------------------------------------
# FIGÉES À LA CONSTRUCTION de l'image : la base préfixe chaque URL d'asset écrite
# dans le HTML. Les changer sans reconstruire ne les réécrit pas.
NUXT_APP_BASE_URL=/v2/
NUXT_PUBLIC_API_BASE=/v2/api

# --- Base de données ----------------------------------------------------------
POSTGRES_PASSWORD=      # À REMPLIR — `openssl rand -base64 32`

# --- Authentification ---------------------------------------------------------
AUTH_SIGNING_KEY=       # À REMPLIR — `openssl rand -hex 32`, puis NE PLUS EN CHANGER :
                        # la remplacer invalide toutes les sessions en cours.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=     # VIDE, et c'est voulu : le cookie se rattache alors au
                        # seul hôte que le navigateur a contacté.

# --- Mandataires de confiance -------------------------------------------------
# Deux sauts, donc deux entrées : le réseau interne de Docker, d'où Caddy parle
# à l'API, et l'adresse du cPanel, qui a constaté celle du visiteur. L'API
# remonte la chaîne de droite à gauche en sautant les mandataires connus ; le
# premier inconnu est le client.
#
# Les OUBLIER n'empêche rien de fonctionner : ça fait simplement enregistrer
# l'adresse du relais dans chaque session et chaque ligne d'audit, à la place de
# celle du visiteur. Le défaut ferme — il vaut mieux une adresse fausse mais
# visible qu'une adresse que le client aurait choisie lui-même.
TRUSTED_PROXIES=172.28.0.0/16,68.168.118.201

# --- Courriel -----------------------------------------------------------------
# L'API envoie elle-même, par le serveur du domaine, en client authentifié.
MAIL_TRANSPORT=smtp
SMTP_HOST=epavillonclimatique.francophonie.org
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=          # À REMPLIR — la boîte créée dans cPanel
SMTP_PASSWORD=          # À REMPLIR
# La MÊME valeur que SMTP_USERNAME : un serveur de soumission n'accepte le plus
# souvent qu'un expéditeur appartenant au compte authentifié. Une autre adresse
# se fait refuser en 550, au premier message.
SMTP_FROM=
SMTP_FROM_NAME=ePavillon

# --- Stockage objet -----------------------------------------------------------
S3_REGION=garage
S3_BUCKET=epavillon
S3_ACCESS_KEY_ID=       # À REMPLIR — rendu par `make garage-init` sur ce serveur
S3_SECRET_ACCESS_KEY=   # À REMPLIR
S3_FORCE_PATH_STYLE=true
MEDIA_STORAGE=s3

# --- Traces -------------------------------------------------------------------
# VIDE : aucun collecteur n'est déployé. La renseigner ferait tenter un export à
# chaque trace, vers un service absent.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=epavillon-api
RUST_LOG=info
