  "query": "SELECT s.allows_questions, s.status::text AS \"status!\",\n                  (s.status IN ('live', 'completed') OR s.starts_at <= now()) AS \"commencee!\"\n             FROM programme.sessions s\n             JOIN programme.v_public_schedule v ON v.id = s.id\n            WHERE s.id = $1",
