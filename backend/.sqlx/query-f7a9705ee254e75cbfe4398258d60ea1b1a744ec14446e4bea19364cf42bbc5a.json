  "query": "SELECT DISTINCT o.id, o.legal_name, o.acronym\n             FROM org.organizations o\n            WHERE EXISTS (\n                      SELECT 1 FROM programme.sessions s\n                       WHERE s.organization_id = o.id AND s.event_id = $1\n                  )\n            ORDER BY o.legal_name",
