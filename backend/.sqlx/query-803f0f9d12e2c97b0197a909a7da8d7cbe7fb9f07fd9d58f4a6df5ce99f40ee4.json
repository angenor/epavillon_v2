  "query": "SELECT d.domain, d.verified_at,\n                  EXISTS (\n                      SELECT 1 FROM org.organization_domains t\n                       WHERE t.organization_id = $2 AND t.domain = d.domain\n                  ) AS \"already_present!\"\n             FROM org.organization_domains d\n            WHERE d.organization_id = $1\n            ORDER BY d.domain",
