  "query": "SELECT o.id,\n                  o.legal_name,\n                  COALESCE(platform.t(c.name, $1), o.city) AS \"hint?\"\n             FROM org.organizations o\n             LEFT JOIN reference.countries c ON c.id = o.country_id\n            WHERE o.status <> 'merged'\n            ORDER BY o.legal_name",
