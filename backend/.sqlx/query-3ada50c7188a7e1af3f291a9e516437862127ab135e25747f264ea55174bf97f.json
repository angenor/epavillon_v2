  "query": "SELECT f.entry_id, f.helpful, f.missing_reason, f.updated_at\n           FROM negotiation.faq_feedback f\n           JOIN negotiation.faq_entries e ON e.id = f.entry_id\n          WHERE f.person_id = $1 AND e.status <> 'draft'\n          ORDER BY f.entry_id",
