  "query": "SELECT f.id, f.allows_anonymous, to_jsonb(f) AS \"form!\"\n             FROM programme.registration_forms f\n            WHERE f.is_default AND (f.event_id = $1 OR f.event_id IS NULL)\n            ORDER BY (f.event_id IS NOT NULL) DESC\n            LIMIT 1",
