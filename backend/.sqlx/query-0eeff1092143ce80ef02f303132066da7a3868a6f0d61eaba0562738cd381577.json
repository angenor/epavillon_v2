  "query": "SELECT p.id,\n                  p.primary_email::text AS \"email!\",\n                  p.first_name,\n                  p.preferred_locale,\n                  p.email_verified_at,\n                  EXISTS (\n                      SELECT 1 FROM identity.accounts a\n                       WHERE a.person_id = p.id AND a.provider = 'password'\n                  ) AS \"a_un_compte!\"\n             FROM identity.people p\n            WHERE p.primary_email = $1::text::platform.email",
