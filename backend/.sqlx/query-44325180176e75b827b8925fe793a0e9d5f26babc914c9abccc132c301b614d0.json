  "query": "SELECT r.id, r.venue_id, r.name, r.code, r.capacity,\n                  r.is_virtual, r.has_streaming, r.equipment, r.sort_order\n             FROM event.rooms r\n             JOIN event.venues v ON v.id = r.venue_id\n            WHERE v.event_id = $1\n            ORDER BY r.sort_order, r.code",
