  "query": "SELECT o.id, o.legal_name, o.country_id,\n                  o.contact_email::text AS \"contact_email?\",\n                  o.website::text AS \"website?\"\n             FROM org.organizations o\n            WHERE o.status IN ('candidate', 'active')\n              AND ($1::uuid IS NULL OR o.id > $1)\n            ORDER BY o.id\n            LIMIT $2",
