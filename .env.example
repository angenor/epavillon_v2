# ePavillon v2 — variables d'environnement de développement local.
#
# Copie versionnée et commentée de `.env`, qui est le seul des deux à ne PAS
# être suivi par git. Pour démarrer :  cp .env.example .env
#
# Référence : docs/ENVIRONNEMENT_LOCAL.md

# --- Base de données ---------------------------------------------------------
# Lue par SQLx À LA COMPILATION : la base doit tourner avant `cargo build`.
# Sans elle, ce n'est pas l'exécution qui échoue mais `cargo` lui-même.
DATABASE_URL=postgres://postgres:dev@localhost:5432/epavillon

# --- API ---------------------------------------------------------------------
API_BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,epavillon=debug

# --- Front (Nuxt) ------------------------------------------------------------
# Le préfixe NUXT_PUBLIC_ expose la variable au navigateur : rien d'autre ici.
# Lue par frontend/app/composables/useApi.ts, qui S'EN SERT DÈS MAINTENANT :
# tant qu'elle est VIDE, les écrans lisent les données simulées de
# frontend/app/mocks/ ; dès qu'elle est renseignée, les mêmes appels partent
# vers l'API.
#
# ELLE DOIT DONC RESTER VIDE JUSQU'AU PROMPT B7. L'API Rust n'existe pas encore
# (prompt B1) : la renseigner fait échouer tous les chargements de données et
# affiche l'état d'erreur sur chaque écran, y compris le guide de style.
# Au raccordement, y remettre http://localhost:8080/api
NUXT_PUBLIC_API_BASE=

# Adresse publique du site. Sert aux liens alternatifs de langue (`hreflang`) et
# aux URL canoniques produits par @nuxtjs/i18n. En local, laisser l'adresse du
# serveur de développement.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cache -------------------------------------------------------------------
VALKEY_URL=redis://localhost:6379

# --- Stockage objet (Garage, compatible S3) ----------------------------------
# Les deux clés proviennent de `make garage-init` — voir
# docs/ENVIRONNEMENT_LOCAL.md § « Initialisation de Garage ».
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=epavillon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Courriel (Mailpit : capture tout, n'envoie rien) ------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ne-pas-repondre@epavillon.local

# --- Traces (Jaeger, OTLP sur HTTP) ------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=epavillon-api

# --- Ports publiés par ops/docker-compose.dev.yml ----------------------------
# À ne changer que si un autre projet occupe déjà le port sur la machine.
# Toute modification ici doit être répercutée dans les URL ci-dessus.
POSTGRES_PORT=5432
VALKEY_PORT=6379
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MAILPIT_UI_PORT=8025
S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903

# --- Compte de démonstration du jeu simulé -----------------------------------
# Sert aux vérifications manuelles et aux parcours de navigateur tant que le
# frontend tourne sur les données simulées (NUXT_PUBLIC_API_BASE vide).
# Awa Sow Fall a une adhésion ACTIVE : elle franchit la garde
# `requires-organization` et peut déposer une proposition (écran A4).
# Le mot de passe est celui de TOUS les comptes simulés — `DEMO_PASSWORD` dans
# `frontend/app/mocks/auth.ts` —, il n'ouvre rien d'autre que des mocks.
# Autres comptes utiles, même mot de passe :
#   b.ouedraogo@osed-sahel.org   référent de la fiche OSED (doublon volontaire)
#   c.perret@francophonie.org    administratrice de la SEULE édition COP31
#   karim.ilboudo@example.org    aucun droit, et une adhésion EN ATTENTE
DEMO_USER_EMAIL=a.sowfall@roac-afrique.org
DEMO_USER_PASSWORD=ePavillon2027!
