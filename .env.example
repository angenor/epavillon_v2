# ePavillon v2 — variables d'environnement de développement local.
#
# Copie versionnée et commentée de `.env`, qui est le seul des deux à ne PAS
# être suivi par git. Pour démarrer :  cp .env.example .env
#
# Référence : docs/ENVIRONNEMENT_LOCAL.md

# --- Base de données ---------------------------------------------------------
# Lue par SQLx À LA COMPILATION : la base doit tourner avant `cargo build`.
# Sans elle, ce n'est pas l'exécution qui échoue mais `cargo` lui-même.
DATABASE_URL=postgres://postgres:dev@localhost:5432/epavillon

# --- API ---------------------------------------------------------------------
API_BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,epavillon=debug

# --- Front (Nuxt) ------------------------------------------------------------
# Le préfixe NUXT_PUBLIC_ expose la variable au navigateur : rien d'autre ici.
# Lue par frontend/app/composables/useApi.ts pour basculer des données simulées
# vers l'API réelle (prompt B7) — déclarée dès maintenant, inutilisée jusque-là.
NUXT_PUBLIC_API_BASE=http://localhost:8080/api

# --- Cache -------------------------------------------------------------------
VALKEY_URL=redis://localhost:6379

# --- Stockage objet (Garage, compatible S3) ----------------------------------
# Les deux clés proviennent de `make garage-init` — voir
# docs/ENVIRONNEMENT_LOCAL.md § « Initialisation de Garage ».
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=epavillon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Courriel (Mailpit : capture tout, n'envoie rien) ------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ne-pas-repondre@epavillon.local

# --- Traces (Jaeger, OTLP sur HTTP) ------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=epavillon-api

# --- Ports publiés par ops/docker-compose.dev.yml ----------------------------
# À ne changer que si un autre projet occupe déjà le port sur la machine.
# Toute modification ici doit être répercutée dans les URL ci-dessus.
POSTGRES_PORT=5432
VALKEY_PORT=6379
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MAILPIT_UI_PORT=8025
S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
