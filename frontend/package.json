{
  "name": "epavillon-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ePavillon v2 — interface Nuxt 4 de la plateforme IFDD",
  "scripts": {
    "dev": "nuxt dev --dotenv ../.env --host 127.0.0.1",
